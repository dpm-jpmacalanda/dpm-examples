      "query": "timeseries v = avg(argocd_app_info), by: {name, health_status, sync_status, project, dest_namespace}\n| fieldsRemove v\n| filter health_status == \"Suspended\"\n| summarize Apps = countDistinct(name)",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "title": "Waiting for promotion",
      "type": "data",
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "coloring": {
          "thresholdRules": []
        },
        "singleValue": {
          "label": "Apps",
          "labelMode": "none",
