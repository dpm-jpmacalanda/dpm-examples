    "4": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "query": "fetch events\n| filter event.kind == \"SDLC_EVENT\" and event.provider == \"argocd\" and event.status == \"finished\"\n| dedup vcs.ref.base.revision, start_time, cicd.deployment.name\n| summarize Deployments = count()",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "title": "Deployments (7 days)",
      "type": "data",
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "coloring": {
          "thresholdRules": []
        },
        "singleValue": {
          "label": "Deployments",
          "labelMode": "none",
          "recordField": "Deployments",
          "trend": {
            "isVisible": false
          }
        }
      },
      "timeframe": {
        "tileTimeframe": {
          "from": "now()-7d",
