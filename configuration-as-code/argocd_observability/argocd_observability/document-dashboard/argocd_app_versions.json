    "5": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        },
        "enabled": false
      },
      "query": "fetch events\n| filter event.kind == \"SDLC_EVENT\" and event.provider == \"argocd\" and event.status == \"finished\"\n| sort timestamp desc\n| summarize {Version = takeFirst(argocd.app.version), Image = takeFirst(argocd.app.image), `Git revision` = takeFirst(vcs.ref.base.revision), Outcome = takeFirst(task.outcome), `Last deployed` = takeFirst(timestamp), `Deployed by` = takeFirst(argocd.sync.initiated_by), Stage = takeFirst(argocd.app.stage), Parent = takeFirst(argocd.app.parent), Deployments = count()}, by: {Application = cicd.deployment.name}\n| fieldsAdd `Git revision` = substring(`Git revision`, from: 0, to: 8)\n| fields Application, Version, Stage, Outcome, `Last deployed`, `Deployed by`, `Git revision`, Image, Parent, Deployments\n| sort Application asc",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "title": "Current version per application",
      "type": "data",
      "visualization": "table",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "coloring": {
          "colorRules": [
            {
              "colorMode": "custom-color",
              "comparator": "=",
              "customColor": {
                "Default": "var(--dt-colors-charts-categorical-color-03-default, #2a7453)"
              },
              "field": "Outcome",
              "value": "succeeded"
            },
            {
              "colorMode": "custom-color",
              "comparator": "=",
              "customColor": {
                "Default": "var(--dt-colors-charts-categorical-themed-fireplace-color-01-default, #ae132d)"
              },
              "field": "Outcome",
              "value": "failed"
            },
            {
              "colorMode": "custom-color",
              "comparator": "=",
              "customColor": {
                "Default": "var(--dt-colors-charts-categorical-themed-fireplace-color-01-default, #ae132d)"
              },
              "field": "Outcome",
              "value": "error"
            }
          ]
        },
        "table": {
          "colorThresholdTarget": "background"
        }
      },
      "timeframe": {
        "tileTimeframe": {
          "from": "now()-30d",
          "to": "now()"
        },
        "tileTimeframeEnabled": true
      }
    },
    "6": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
