      "query": "timeseries v = avg(argocd_app_info), by: {name, health_status, sync_status, project, dest_namespace}\n| fieldsRemove v\n| lookup [ fetch events, from: now() - 90d\n  | filter event.kind == \"SDLC_EVENT\" and event.provider == \"argocd\" and event.status == \"finished\"\n  | sort timestamp desc\n  | summarize {Version = takeFirst(argocd.app.version), Image = takeFirst(argocd.app.image), `Git revision` = takeFirst(vcs.ref.base.revision), Outcome = takeFirst(task.outcome), `Last deployed` = takeFirst(timestamp), `Deployed by` = takeFirst(argocd.sync.initiated_by), Stage = takeFirst(argocd.app.stage), Parent = takeFirst(argocd.app.parent), Deployments = count()}, by: {Application = cicd.deployment.name}\n  ], sourceField: name, lookupField: Application, prefix: \"dep.\"\n| fields Application = name, Health = health_status, Sync = sync_status, Version = coalesce(dep.Version, \"not subscribed\"), `Last deployed` = `dep.Last deployed`, Project = project, Namespace = dest_namespace\n| sort Application asc",
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "title": "All applications: health, sync and version",
      "type": "data",
      "visualization": "table",
      "visualizationSettings": {
